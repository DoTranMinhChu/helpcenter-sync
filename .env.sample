# Required. API_KEY is accepted as an alias.
OPENAI_API_KEY=sk-...

# Vector store to sync into. If empty, one named VECTOR_STORE_NAME is found or created.
VECTOR_STORE_ID=
VECTOR_STORE_NAME=optibot-kb

ZENDESK_BASE_URL=https://support.optisigns.com
ZENDESK_LOCALE=en-us
# 0 = all published articles
MAX_ARTICLES=0

OUTPUT_DIR=out
UPLOAD_CONCURRENCY=8
# true = scrape and diff only, never write to the vector store
DRY_RUN=false

# Optional: publish each run's log to a public gist (token needs the "gist" scope)
LOG_GIST_ID=
GITHUB_TOKEN=
